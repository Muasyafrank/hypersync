# Optional. When unset the app calls the API on port 8000 of the same host it
# was opened on (so http://localhost:5173 talks to http://localhost:8000).
# Keep the app and the API on the same hostname: the login session is a
# SameSite cookie, and "localhost" and "127.0.0.1" count as different sites.
# VITE_API_BASE_URL=http://localhost:8000
