# Copy to backend/.env and fill in real values. Never commit the real .env.

# PostgreSQL connection string
DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/hypersync

# Signing key for JWTs. Generate a fresh one with:
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=replace-me-with-a-long-random-value

# Optional — defaults shown
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Refresh-token cookie (httpOnly). Behind HTTPS set COOKIE_SECURE=true.
# If the frontend and API are on different *sites* use COOKIE_SAMESITE=none
# (requires COOKIE_SECURE=true). In local dev, open the app and the API on the
# same hostname (both "localhost" or both "127.0.0.1") so the cookie is sent.
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
